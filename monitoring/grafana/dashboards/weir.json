      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cost per 1,000 requests",
      "description": "List prices; actual spend is $0 on free tiers",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "weir-pg"
      },
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "weir-pg"
          },
          "rawSql": "select coalesce(1000 * sum(cost_usd) / nullif(count(*), 0), 0) as \"Cost per 1,000\" from weir.request_log where $__timeFilter(ts) and config_label in ($config) and namespace in ($namespace)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Estimated savings",
      "description": "Counterfactual (no cache, always the large model) minus actual cost",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "weir-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "weir-pg"
          },
          "rawSql": "select coalesce(sum(counterfactual_cost_usd - cost_usd), 0) as \"Saved\" from weir.request_log where $__timeFilter(ts) and config_label in ($config) and namespace in ($namespace)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Savings %",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "weir-pg"
      },
      "gridPos": {
        "x": 9,
