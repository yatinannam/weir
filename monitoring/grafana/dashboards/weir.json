          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "weir-pg"
          },
          "rawSql": "select coalesce(1 - sum(cost_usd) / nullif(sum(counterfactual_cost_usd), 0), 0) as \"Saved\" from weir.request_log where $__timeFilter(ts) and config_label in ($config) and namespace in ($namespace)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
