          "rawSql": "select coalesce(sum((route = 'small')::int)::float / nullif(sum((cache_status <> 'hit')::int), 0), 0) as \"Routed small\" from weir.request_log where $__timeFilter(ts) and config_label in ($config) and namespace in ($namespace)",
