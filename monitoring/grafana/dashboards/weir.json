    {
      "id": 20,
      "type": "barchart",
      "title": "Similarity: hits and near misses",
      "description": "Is the 0.90 threshold sensible? Near misses are lookups that scored 0.80+ but didn't hit",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "weir-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "weir-pg"
          },
          "rawSql": "select to_char(floor(similarity * 100) / 100, 'FM0.00') as \"Similarity\", sum((cache_status = 'hit')::int) as \"hits\", sum((cache_status <> 'hit')::int) as \"near misses\" from weir.request_log where $__timeFilter(ts) and config_label in ($config) and namespace in ($namespace) and similarity >= 0.80 group by 1 order by 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
