          "rawSql": "select case when cache_status = 'hit' then 'cache hit' else route || ' model' end as \"Path\", count(*) as \"Requests\", percentile_cont(0.5) within group (order by latency_total_ms) as \"p50 (ms)\", percentile_cont(0.95) within group (order by latency_total_ms) as \"p95 (ms)\", percentile_cont(0.99) within group (order by latency_total_ms) as \"p99 (ms)\" from weir.request_log where $__timeFilter(ts) and config_label in ($config) and namespace in ($namespace) and status = 'ok' and (cache_status = 'hit' or route in ('small', 'large')) group by 1 order by 1",
