    {
      "id": 11,
      "type": "table",
      "title": "Configuration comparison",
      "description": "The four-way ablation, live from the request log",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "weir-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
