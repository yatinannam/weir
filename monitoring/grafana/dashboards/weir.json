{
  "uid": "weir",
  "title": "Weir",
  "tags": [
    "weir"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
